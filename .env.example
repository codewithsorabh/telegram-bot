# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Copy this file to .env and fill in your real values.
#
#  Generate ENCRYPTION_KEY with:
#    python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# ─────────────────────────────────────────────────────────────────────────────


# ── Debug ────────────────────────────────────────────────────────────────────
# Set to True during development; False in production
DEBUG=True

MAX_CONCURRENT_WORKERS=2000
SCHEDULER_INTERVAL=60

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=mybot_db
POSTGRES_USER=mybot_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379


# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ1234567890

# Primary admin Telegram user ID(s).
# Supports a single ID or multiple comma-separated IDs (no spaces):
#   Single:   ADMIN_ID=123456789
#   Multiple: ADMIN_ID=123456789,987654321
ADMIN_ID=123456789,987654321


# ── Auto Delete ───────────────────────────────────────────────────────────────
# Delete user messages from the chat after a delay (true/false)
AUTO_DELETE=true
# Delay in seconds before deleting messages
AUTO_DELETE_TIME=120


# ── Encryption ───────────────────────────────────────────────────────────────
# Fernet-compatible 32-byte URL-safe base64 key used to encrypt session strings.
# Generate a new key with:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=mtHXJlODK-GyRQDf4nZxKZN6DHLVJkbB2PGKo2wgV-Y=
